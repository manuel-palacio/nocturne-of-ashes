# Spanish for the interface of Nocturne of Ashes (the conversations are in es-dialogue.po). The message
# ids are the English source texts, byte for byte. Maintained by hand: see the README, "Languages".
msgid ""
msgstr ""
"Project-Id-Version: Nocturne of Ashes\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# HUD prompts
msgid "You have fallen"
msgstr "Has caído"

msgid "You have fallen — press Enter or click"
msgstr "Has caído — pulsa Intro o haz clic"

msgid "Paused — give your orders"
msgstr "En pausa — da tus órdenes"

msgid "The vault is quiet"
msgstr "La cripta está en silencio"

msgid "The vault is quiet. The story rests here, for now."
msgstr "La cripta está en silencio. La historia se detiene aquí, por ahora."

msgid "The vault's guard has closed ranks again."
msgstr "La guardia de la cripta ha vuelto a cerrar filas."

msgid "The guard is tiring."
msgstr "La guardia se cansa."

msgid "The guard has closed ranks, and tires."
msgstr "La guardia ha cerrado filas, y se cansa."

msgid "Alma"
msgstr "Alma"

# Party member states
msgid "Fallen"
msgstr "Fuera de combate"

msgid "The Fury"
msgstr "La Furia"

msgid "Feeding"
msgstr "Alimentándose"

# Unit names
msgid "Brother Álvar"
msgstr "Hermano Álvar"

msgid "Crusader"
msgstr "Cruzado"

msgid "Sergeant"
msgstr "Sargento"

msgid "Zahra"
msgstr "Zahra"

msgid "Gonzalo"
msgstr "Gonzalo"

# Rite names
msgid "Iron Sinew"
msgstr "Tendón de Hierro"

msgid "Baleful Eye"
msgstr "Ojo Funesto"

msgid "Mend Flesh"
msgstr "Sanar la Carne"

msgid "Blood Lance"
msgstr "Lanza de Sangre"

msgid "Stone Hide"
msgstr "Piel de Piedra"

msgid "Hammerfall"
msgstr "Martillazo"

# Title
msgid "Continue"
msgstr "Continuar"

msgid "New game"
msgstr "Nueva partida"

msgid "Controls"
msgstr "Controles"

msgid "Erase the saved game?"
msgstr "¿Borrar la partida guardada?"

msgid "Yes, begin anew"
msgstr "Sí, empezar de nuevo"

msgid "No"
msgstr "No"

msgid "Preparing the cellars…"
msgstr "Preparando los sótanos…"

msgid "Preparing the cellars… %d of %d"
msgstr "Preparando los sótanos… %d de %d"

msgid "This browser is not keeping saves: progress lasts until the page is closed."
msgstr "Este navegador no guarda las partidas: el progreso dura hasta que se cierre la página."

# Doors
msgid "Not while they are upon you"
msgstr "No mientras los tengas encima"

msgid "Not while the Fury has you."
msgstr "No mientras te domine la Furia."

msgid "The stair is barred until Malakor says otherwise"
msgstr "La escalera está cerrada hasta que Malakor diga otra cosa"

msgid "The last lock does not yield. Not yet."
msgstr "El último cerrojo no cede. Aún no."

msgid "The last lock does not yield. This is where the story rests, for now."
msgstr "El último cerrojo no cede. Aquí se detiene la historia, por ahora."

# Feeding
msgid "%s's Blood is full"
msgstr "%s tiene la Sangre llena"

# Dialogue box
msgid "Enter or click"
msgstr "Intro o clic"

msgid "1 or click"
msgstr "1 o clic"

msgid "1–%d or click"
msgstr "1–%d o clic"

# Controls card
msgid "Escape or click outside to close"
msgstr "Escape o clic fuera para cerrar"

msgid "Left click"
msgstr "Clic izquierdo"

msgid "Move; on an enemy, attack it"
msgstr "Moverse; sobre un enemigo, atacarlo"

msgid "Left click a weakened enemy"
msgstr "Clic en un enemigo debilitado"

msgid "Feed on them, when short of Blood"
msgstr "Alimentarse de él, si falta Sangre"

msgid "Tab, or click a companion or a panel"
msgstr "Tab, o clic en un compañero o en su panel"

msgid "Select a party member"
msgstr "Elegir a un miembro del grupo"

msgid "1, 2, or click a Rite"
msgstr "1, 2, o clic en un Rito"

msgid "Use a Rite, then click its target if it needs one; Escape or a right click cancels"
msgstr "Usar un Rito y, si lo necesita, hacer clic en su objetivo; Escape o clic derecho lo cancela"

msgid "Space"
msgstr "Espacio"

msgid "Pause and resume; orders given while paused begin on resume"
msgstr "Pausar y reanudar; las órdenes dadas en pausa se cumplen al reanudar"

msgid "Q and E, mouse wheel"
msgstr "Q y E, rueda del ratón"

msgid "Turn the camera, zoom"
msgstr "Girar la cámara, acercar o alejar"

msgid "Left click someone"
msgstr "Clic en alguien"

msgid "Walk up and talk; Enter or a click goes on, 1–4 choose"
msgstr "Acercarse y hablar; Intro o clic avanza, 1–4 eligen"

msgid "Left click a door"
msgstr "Clic en una puerta"

msgid "Take the party through it"
msgstr "Cruzarla con el grupo"

msgid "Enter or click, after a fall"
msgstr "Intro o clic, tras caer"

msgid "Begin again from the last checkpoint"
msgstr "Volver a empezar desde el último punto de control"

# Closing card
msgid "Here the descent rests"
msgstr "Aquí se detiene el descenso"

msgid "The last lock of Toledo's vaults is still shut, and what waits behind it is not yet written. Your game is saved: when the story goes on, it goes on from here, with the Alma you carry (%d of 10)."
msgstr "El último cerrojo de las criptas de Toledo sigue echado, y lo que aguarda tras él aún no está escrito. Tu partida está guardada: cuando la historia continúe, lo hará desde aquí, con el Alma que llevas (%d de 10)."

msgid "The last lock of Toledo's vaults is still shut, and what waits behind it is not yet written. This browser is not keeping saves: your progress, and the Alma you carry (%d of 10), last until the page is closed."
msgstr "El último cerrojo de las criptas de Toledo sigue echado, y lo que aguarda tras él aún no está escrito. Este navegador no guarda las partidas: tu progreso, y el Alma que llevas (%d de 10), duran hasta que se cierre la página."

msgid "Enter or click to stay in the vault"
msgstr "Intro o clic para quedarte en la cripta"

# Hints, shown once each as the fight's rules first apply
msgid "Space pauses the fight: give your orders, then let it run."
msgstr "Espacio pone el combate en pausa: da tus órdenes y luego déjalo seguir."

msgid "1: Iron Sinew, to strike harder. 2: Baleful Eye, then click a foe to still him."
msgstr "1: Tendón de Hierro, para golpear más fuerte. 2: Ojo Funesto y clic en un enemigo para paralizarlo."

msgid "The helmed sergeants hit hardest. Still one with Baleful Eye, and drink when he weakens."
msgstr "Los sargentos con yelmo golpean más fuerte. Paraliza a uno con el Ojo Funesto y bebe de él cuando flaquee."

msgid "Click a weakened foe to feed: it restores Blood and mends wounds."
msgstr "Haz clic en un enemigo debilitado para beber: devuelve Sangre y cura heridas."

msgid "%s is running dry. Feed, or the Fury will choose for you."
msgstr "%s se queda sin Sangre. Aliméntate, o la Furia elegirá por ti."

msgid "The Fury has %s. It ends when the hunger is fed or burns out."
msgstr "La Furia se ha apoderado de %s. Acaba cuando el hambre se sacia o se apaga."

msgid "The west door is a way out. The guard will close ranks again."
msgstr "La puerta oeste es una salida. La guardia volverá a cerrar filas."
