# Spanish texts for Nocturne of Ashes. The message ids are the English source texts, byte for byte.
msgid ""
msgstr ""
"Project-Id-Version: Nocturne of Ashes\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# HUD prompts
msgid "You have fallen — press Enter or click"
msgstr "Has caído — pulsa Intro o haz clic"

msgid "Paused — give your orders"
msgstr "En pausa — da tus órdenes"

msgid "The vault is quiet"
msgstr "La cripta está en silencio"

msgid "Conscience"
msgstr "Conciencia"

# Party member states
msgid "Fallen"
msgstr "Caído"

msgid "The Fury"
msgstr "La Furia"

msgid "Feeding"
msgstr "Alimentándose"

# Unit names
msgid "Brother Álvar"
msgstr "Hermano Álvar"

msgid "Crusader"
msgstr "Cruzado"

msgid "Sergeant"
msgstr "Sargento"

# Gift names
msgid "Iron Sinew"
msgstr "Tendón de Hierro"

msgid "Baleful Eye"
msgstr "Ojo Funesto"

msgid "Mend Flesh"
msgstr "Sanar la Carne"

msgid "Blood Lance"
msgstr "Lanza de Sangre"

msgid "Stone Hide"
msgstr "Piel de Piedra"

msgid "Hammerfall"
msgstr "Martillazo"

# Title
msgid "Continue"
msgstr "Continuar"

msgid "New game"
msgstr "Nueva partida"

msgid "Controls"
msgstr "Controles"

msgid "Erase the saved game?"
msgstr "¿Borrar la partida guardada?"

msgid "Yes, begin anew"
msgstr "Sí, empezar de nuevo"

msgid "No"
msgstr "No"

msgid "Preparing the cellars…"
msgstr "Preparando las bóvedas…"

# Doors
msgid "Not while they are upon you"
msgstr "No mientras los tengas encima"

msgid "The stair is barred until Malakor says otherwise"
msgstr "La escalera está cerrada hasta que Malakor diga otra cosa"

msgid "The last lock does not yield. Not yet."
msgstr "El último cerrojo no cede. Aún no."

# People
msgid "The captive"
msgstr "El cautivo"

# Dialogue box
msgid "Enter or click"
msgstr "Intro o clic"

msgid "1–4 or click"
msgstr "1–4 o clic"

# Controls card
msgid "Escape or click outside to close"
msgstr "Escape o clic fuera para cerrar"

msgid "Left click"
msgstr "Clic izquierdo"

msgid "Move; on an enemy, attack it"
msgstr "Moverse; sobre un enemigo, atacarlo"

msgid "Left click a weakened enemy"
msgstr "Clic en un enemigo debilitado"

msgid "Feed on them, when short of Blood"
msgstr "Alimentarse de él, si falta Sangre"

msgid "Tab, or click a companion or a panel"
msgstr "Tab, o clic en un compañero o en su panel"

msgid "Select a party member"
msgstr "Elegir a un miembro del grupo"

msgid "1, 2, or click a Gift"
msgstr "1, 2, o clic en un Don"

msgid "Use a Gift, then click its target if it needs one; Escape or a right click cancels"
msgstr "Usar un Don y, si lo necesita, hacer clic en su objetivo; Escape o clic derecho lo cancela"

msgid "Space"
msgstr "Espacio"

msgid "Pause and resume; orders given while paused begin on resume"
msgstr "Pausar y seguir; las órdenes dadas en pausa empiezan al seguir"

msgid "Q and E, mouse wheel"
msgstr "Q y E, rueda del ratón"

msgid "Turn the camera, zoom"
msgstr "Girar la cámara, acercar o alejar"

msgid "Left click someone"
msgstr "Clic en alguien"

msgid "Walk up and talk; Enter or a click goes on, 1–4 choose"
msgstr "Acercarse y hablar; Intro o un clic sigue, 1–4 eligen"

msgid "Left click a door"
msgstr "Clic en una puerta"

msgid "Take the party through it"
msgstr "Llevar al grupo a través de ella"

msgid "Enter or click, after a fall"
msgstr "Intro o clic, tras caer"

msgid "Begin again from the last checkpoint"
msgstr "Volver a empezar desde el último punto de control"
